// Modèle de données MoneyTrack, issu du MLD du dossier de cadrage (section 6.2).
// Montants en Decimal(12,2), jamais en flottant.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CHECKING
  SAVINGS
  OTHER
}

enum MatchType {
  CONTAINS
  STARTS_WITH
  EQUALS
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  passwordHash String         @map("password_hash")
  firstName    String         @map("first_name")
  lastName     String         @map("last_name")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  accounts     Account[]
  refreshTokens RefreshToken[]
  categories   Category[]
  rules        CategoryRule[]
  budgets      Budget[]
  transactions Transaction[]

  @@map("users")
}

// Jetons de rafraîchissement, stockés hachés et révocables
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Account {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  name           String
  type           AccountType   @map("account_type")
  currency       String        @default("EUR") @db.Char(3)
  initialBalance Decimal       @default(0) @map("initial_balance") @db.Decimal(12, 2)
  // Correspondance des colonnes CSV mémorisée pour ce compte (US-04)
  csvMapping     Json?         @map("csv_mapping")
  createdAt      DateTime      @default(now()) @map("created_at")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  imports        Import[]

  // Cible de la clé étrangère composite des transactions (isolation par utilisateur)
  @@unique([id, userId])
  @@index([userId])
  @@map("accounts")
}

model Category {
  id           String         @id @default(uuid()) @db.Uuid
  // NULL = catégorie par défaut, commune à tous les utilisateurs
  userId       String?        @map("user_id") @db.Uuid
  name         String
  colorCode    String         @map("color_code")
  iconName     String         @map("icon_name")
  user         User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  rules        CategoryRule[]
  budgets      Budget[]

  @@unique([userId, name])
  @@map("categories")
}

// Règles de catégorisation automatique (US-06). Pas d'expression régulière
// saisie par l'utilisateur, pour éviter les attaques par déni de service (ReDoS).
model CategoryRule {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  categoryId String    @map("category_id") @db.Uuid
  pattern    String
  matchType  MatchType @map("match_type")
  // Plus la valeur est élevée, plus la règle est prioritaire
  priority   Int       @default(0)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, priority])
  @@map("category_rules")
}

model Import {
  id             String        @id @default(uuid()) @db.Uuid
  accountId      String        @map("account_id") @db.Uuid
  fileName       String        @map("file_name")
  importedAt     DateTime      @default(now()) @map("imported_at")
  rowsRead       Int           @map("rows_read")
  rowsImported   Int           @map("rows_imported")
  rowsDuplicated Int           @map("rows_duplicated")
  account        Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions   Transaction[]

  @@map("imports")
}

model Transaction {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  accountId       String    @map("account_id") @db.Uuid
  // NULL = transaction non catégorisée
  categoryId      String?   @map("category_id") @db.Uuid
  // NULL = saisie manuelle
  importId        String?   @map("import_id") @db.Uuid
  // Montant signé : négatif = débit
  amount          Decimal   @db.Decimal(12, 2)
  transactionDate DateTime  @map("transaction_date") @db.Date
  label           String
  // Empreinte SHA-256 anti-doublon ; NULL pour une saisie manuelle
  hashFingerprint String?   @map("hash_fingerprint") @db.Char(64)
  createdAt       DateTime  @default(now()) @map("created_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         Account   @relation(fields: [accountId, userId], references: [id, userId], onDelete: Cascade)
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  import          Import?   @relation(fields: [importId], references: [id], onDelete: SetNull)

  @@unique([accountId, hashFingerprint])
  @@index([userId, transactionDate])
  @@map("transactions")
}

model Budget {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  categoryId            String   @map("category_id") @db.Uuid
  monthlyLimit          Decimal  @map("monthly_limit") @db.Decimal(12, 2)
  alertThresholdPercent Int      @default(80) @map("alert_threshold_percent") @db.SmallInt
  periodMonth           Int      @map("period_month") @db.SmallInt
  periodYear            Int      @map("period_year") @db.SmallInt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category              Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, periodYear, periodMonth])
  @@map("budgets")
}
