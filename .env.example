# Copier ce fichier en .env puis remplacer les valeurs. Ne jamais committer .env.

# Base de données (utilisée par docker compose)
POSTGRES_USER=moneytrack
POSTGRES_PASSWORD=change-me
POSTGRES_DB=moneytrack

# API (développement local, base exposée par docker-compose.dev.yml)
DATABASE_URL=postgresql://moneytrack:change-me@localhost:5432/moneytrack?schema=public
PORT=3000

# Secret de signature des jetons d'accès : 32 caractères aléatoires minimum
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=remplacer-par-une-chaine-aleatoire-de-32-caracteres
